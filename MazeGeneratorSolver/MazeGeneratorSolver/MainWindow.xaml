<Window x:Class="MazeGeneratorSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maze Generator and Solver"
        Height="780"
        Width="1200"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- Стиль кнопок -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <!-- Стиль заголовків секцій -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель -->
        <Border Grid.Row="0"
                Background="#111827"
                CornerRadius="14"
                Padding="20">

            <TextBlock Text="MAZE GENERATOR"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="25"
                       FontWeight="Bold"/>

        </Border>

        <!-- Основна частина -->
        <Grid Grid.Row="1" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="295"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Панель керування -->
            <Border Grid.Column="0"
                    Background="#111827"
                    CornerRadius="14"
                    Padding="17"
                    Margin="0,0,15,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <!-- Відступ між елементами та смугою прокрутки -->
                    <Border Padding="0,0,18,0">

                        <StackPanel>

                            <TextBlock Text="CONTROLS"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"/>

                            <!-- Налаштування лабіринту -->
                            <TextBlock Text="MAZE SETTINGS"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Maze size"
                                       Foreground="#CBD5E1"
                                       FontSize="13"
                                       Margin="0,0,0,3"/>

                            <ComboBox x:Name="SizeComboBox"
                                      SelectedIndex="1"
                                      Height="35"
                                      Margin="0,5,0,5"
                                      Padding="6"
                                      FontFamily="Segoe UI"
                                      FontSize="13">

                                <ComboBoxItem Content="10 x 10"/>
                                <ComboBoxItem Content="15 x 15"/>
                                <ComboBoxItem Content="20 x 20"/>
                                <ComboBoxItem Content="25 x 25"/>
                                <ComboBoxItem Content="30 x 30"/>

                            </ComboBox>

                            <!-- Вибір алгоритму -->
                            <TextBlock Text="SEARCH ALGORITHM"
                                       Style="{StaticResource SectionTitle}"/>

                            <ComboBox x:Name="AlgorithmComboBox"
                                      SelectedIndex="0"
                                      Height="35"
                                      Margin="0,5,0,5"
                                      Padding="6"
                                      FontFamily="Segoe UI"
                                      FontSize="13">

                                <ComboBoxItem Content="BFS"/>
                                <ComboBoxItem Content="DFS"/>

                            </ComboBox>

                            <!-- Швидкість анімації -->
                            <TextBlock Text="ANIMATION SPEED"
                                       Style="{StaticResource SectionTitle}"/>

                            <DockPanel Margin="0,0,0,2">

                                <TextBlock Text="Speed"
                                           Foreground="#CBD5E1"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="SpeedValueText"
                                           Text="3x"
                                           Foreground="#60A5FA"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           HorizontalAlignment="Right"
                                           DockPanel.Dock="Right"
                                           VerticalAlignment="Center"/>

                            </DockPanel>

                            <Slider x:Name="SpeedSlider"
                                    Minimum="1"
                                    Maximum="5"
                                    Value="3"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Height="28"
                                    Margin="0,2,0,5"
                                    Foreground="#3B82F6"
                                    ToolTip="Animation speed"/>

                            <!-- Кнопки керування -->
                            <TextBlock Text="ACTIONS"
                                       Style="{StaticResource SectionTitle}"/>

                            <Button x:Name="GenerateButton"
                                    Content="Generate Maze"
                                    Style="{StaticResource ActionButton}"/>

                            <Button x:Name="SolveButton"
                                    Content="Solve Maze"
                                    Style="{StaticResource ActionButton}"
                                    Background="#7C3AED"/>

                            <Button x:Name="ResetButton"
                                    Content="Reset"
                                    Style="{StaticResource ActionButton}"
                                    Background="#374151"/>

                            <!-- Статистика -->
                            <TextBlock Text="STATISTICS"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Path length"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="PathLengthText"
                                       Text="—"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Visited cells"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,7,0,0"/>

                            <TextBlock x:Name="VisitedCellsText"
                                       Text="—"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Execution time"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,7,0,0"/>

                            <TextBlock x:Name="ExecutionTimeText"
                                       Text="—"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                        </StackPanel>

                    </Border>

                </ScrollViewer>

            </Border>

            <!-- Поле лабіринту -->
            <Border Grid.Column="1"
                    Background="#111827"
                    CornerRadius="14"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="MAZE PREVIEW"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <Border Grid.Row="1"
                            Background="#0B1020"
                            CornerRadius="8"
                            Padding="10">

                        <Canvas x:Name="MazeCanvas"
                                Background="#0B1020"
                                ClipToBounds="True"/>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
